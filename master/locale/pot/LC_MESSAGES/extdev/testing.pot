#: ../../../extdev/testing.rst:59
msgid ""
"When multiple tests with a module are marked with the same ``shared_result`` "
"value, they will share the same build result as well as status and warning "
"buffers. This allows related tests to avoid redundant rebuilds and reuse the "
"same build context."
msgstr ""

#: ../../../extdev/testing.rst:64
msgid "*shared_result* and *srcdir* are mutually incompatible."
msgstr ""

#: ../../../extdev/testing.rst:66
msgid ""
"@pytest.mark.test_params(shared_result='html_build')\n"
"def test_html_title(app: SphinxTestApp) -> None:\n"
"    app.build()\n"
"    # ... test something about the HTML output ...\n"
"\n"
"@pytest.mark.test_params(shared_result='html_build')\n"
"def test_html_index(app: SphinxTestApp) -> None:\n"
"    app.build()\n"
"    # ... test something else about the HTML output ..."
msgstr ""

