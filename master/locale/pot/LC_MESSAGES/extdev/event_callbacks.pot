#: ../../../extdev/event_callbacks.rst:4
msgid "Event callbacks API"
msgstr ""

#: ../../../extdev/event_callbacks.rst:6
msgid ""
"Connecting callback functions to events is a simple way to extend Sphinx, by "
"hooking into the build process at various points."
msgstr ""

#: ../../../extdev/event_callbacks.rst:9
msgid ""
"Use :meth:`.Sphinx.connect` in an extension's ``setup`` function, or a "
"``setup`` function in your project's :file:`conf.py`, to connect functions "
"to the events:"
msgstr ""

#: ../../../extdev/event_callbacks.rst:13
msgid ""
"def source_read_handler(app, docname, source):\n"
"    print('do something here...')\n"
"\n"
"def setup(app):\n"
"    app.connect('source-read', source_read_handler)"
msgstr ""

#: ../../../extdev/event_callbacks.rst:23
msgid ""
"Extensions can add their own events by using :meth:`.Sphinx.add_event`, and "
"calling them them with :meth:`.EventManager.emit` "
"or :meth:`.EventManager.emit_firstresult`."
msgstr ""

#: ../../../extdev/event_callbacks.rst:27
msgid ""
"Many events pass a :term:`doctree` to their callbacks. See the glossary "
"entry for where its node types are documented."
msgstr ""

#: ../../../extdev/event_callbacks.rst:31
msgid "Core events overview"
msgstr ""

#: ../../../extdev/event_callbacks.rst:33
msgid "Below is an overview of the core event that happens during a build."
msgstr ""

#: ../../../extdev/event_callbacks.rst:35
msgid ""
"1. event.config-inited(app,config)\n"
"2. event.builder-inited(app)\n"
"3. event.env-get-outdated(app, env, added, changed, removed)\n"
"4. event.env-before-read-docs(app, env, docnames)\n"
"\n"
"for docname in docnames:\n"
"   5. event.env-purge-doc(app, env, docname)\n"
"\n"
"   if doc changed and not removed:\n"
"      6. source-read(app, docname, source)\n"
"      7. run source parsers: text -> docutils.document\n"
"         - parsers can be added with the app.add_source_parser() API\n"
"         - event.include-read(app, relative_path, parent_docname, content)\n"
"           is called for each include directive\n"
"      8. apply transforms based on priority: docutils.document -> "
"docutils.document\n"
"         - event.doctree-read(app, doctree) is called in the middle of "
"transforms,\n"
"           transforms come before/after this event depending on their "
"priority.\n"
"\n"
"9. event.env-merge-info(app, env, docnames, other)\n"
"   - if running in parallel mode, this event will be emitted for each "
"process\n"
"\n"
"10. event.env-updated(app, env)\n"
"11. event.env-get-updated(app, env)\n"
"\n"
"if environment is written to disk:\n"
"   12. event.env-check-consistency(app, env)\n"
"\n"
"13. event.write-started(app, builder)\n"
"    - This is called after ``app.parallel_ok`` has been set,\n"
"      which must not be altered by any event handler.\n"
"\n"
"# The updated-docs list can be builder dependent, but generally includes all "
"new/changed documents,\n"
"# plus any output from `env-get-updated`, and then all \"parent\" documents "
"in the ToC tree\n"
"# For builders that output a single page, they are first joined into a "
"single doctree before post-transforms\n"
"# or the doctree-resolved event is emitted\n"
"for docname in updated-docs:\n"
"   14. apply post-transforms (by priority): docutils.document -> "
"docutils.document\n"
"   15. event.doctree-resolved(app, doctree, docname)\n"
"       - In the event that any reference nodes fail to resolve, the "
"following may emit:\n"
"       - event.missing-reference(app, env, node, contnode)\n"
"       - event.warn-missing-reference(app, domain, node)\n"
"\n"
"16. Generate output files\n"
"17. event.build-finished(app, exception)"
msgstr ""

